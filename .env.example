# Copy to `.env` in the SAME directory on the server and fill in real values. Never commit real
# secrets. CI does NOT create or touch this file.

# "prod" or "beta" (unique per directory); drives container/volume names.
ENV_NAME=prod
# External Docker network shared with the other MSVs (create once: docker network create qm-net-prod)
NETWORK_NAME=qm-net-prod

# --- Database (own Postgres container) ---
DB_USER_NAME=postgres
DB_PASSWORD=change-me
DB_NAME=payments_db

# Host-published HTTP port (debugging only); differs between prod and beta.
HTTP_HOST_PORT=3011
# TCP listen port inside the container.
TCP_PORT=4011

# --- Order-MSV (we ask it for the locked order total and tell it when an order is paid) ---
ORDER_SERVICE_HOST=qm-prod-order-app
ORDER_SERVICE_PORT=4009

# --- Provider ---
PAYMENT_PROVIDER=stripe
# Methods offered in the Store App's payment sheet.
PAYMENT_METHODS=card,upi,netbanking
# Stripe secret key (sk_test_... / sk_live_...) and the webhook signing secret (whsec_...)
# of the endpoint registered for  https://<api-host>/api/v1/payments/webhook/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional return_url sent when creating the POD UPI QR payment.
STRIPE_UPI_RETURN_URL=
